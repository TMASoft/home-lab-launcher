# Home Lab Launcher example config
NODE_ENV=production

# Docker Compose publishes HOST_PORT on HOST_BIND_IP and keeps PORT as the internal app port.
# Use HOST_BIND_IP=127.0.0.1 when a reverse proxy on the same host handles public traffic.
HOST_BIND_IP=0.0.0.0
HOST_PORT=8080

# HOST controls the interface the Node process listens on inside the container/native process.
# Leave this at 0.0.0.0 for normal Docker bridge networking.
# Only set HOST=127.0.0.1 for an intentional host-network/native fallback behind a same-host reverse proxy.
HOST=0.0.0.0
PORT=8080

# Reverse-proxy trust: false for direct exposure, loopback/1 behind a trusted proxy.
TRUST_PROXY=false

# Server-side fetch SSRF boundary for arbitrary service/icon/asset URLs.
# Use admin-editor for normal home labs, admin for shared deployments, or disabled for public demos.
SERVER_FETCH_PRIVATE_NETWORK_ACCESS=admin-editor

APP_NAME=Home Lab Launcher
APP_BASE_URL=http://localhost:8080
SESSION_SECRET=
DATA_DIR=/app/data
PLUGIN_DIR=/app/data/plugins

# Optional non-interactive bootstrap. Leave both empty to create the first Admin in the UI.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional defaults used on first boot.
# Weather values intentionally default empty to avoid personal or maintainer-specific locations.
PUBLIC_READ_ENABLED=false
WEATHER_LOCATION_LABEL=
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_UNITS=fahrenheit

# Management-plane defaults used on first boot.
LOG_RETENTION_DAYS=90
SCHEDULED_BACKUP_LOCATION=

# Development only: allow Admins to install a plugin from a local filesystem path.
ENABLE_LOCAL_PLUGIN_INSTALL=false

# Optional Docker bind mount for local plugin development.
# In Docker, install plugins using the container path, e.g. /app/local-plugins/news.
LOCAL_PLUGIN_HOST_DIR=./local-plugins
LOCAL_PLUGIN_CONTAINER_DIR=/app/local-plugins
