{
  "name": "home-lab-launcher",
  "version": "0.3.0",
  "private": true,
  "description": "Configurable home lab portal/launcher with roles, weather, and plugins.",
  "license": "MIT",
  "author": "TMASoft",
  "homepage": "https://github.com/TMASoft/home-lab-launcher#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TMASoft/home-lab-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/TMASoft/home-lab-launcher/issues"
  },
  "main": "src/server/index.js",
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "NODE_ENV=development node --watch src/server/index.js",
    "dev:reset": "node scripts/reset-dev-data.js",
    "dev:seed": "node scripts/seed-demo-data.js",
    "check": "find src test scripts -name \"*.js\" -print0 | xargs -0 -n1 node --check",
    "test": "node --test test/*.test.js",
    "test:api": "node --test test/api.test.js",
    "test:frontend": "node --test test/frontend-smoke.test.js",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "release:check": "sh scripts/release-check.sh",
    "validate": "npm run check && npm run release:check && node --test --test-reporter=dot test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "fast-xml-parser": "^5.8.0",
    "tar": "^7.4.3"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
